/// One row per email actually sent. The unique key IS the idempotency: a
/// repeated (kind, studentId, refKey) insert fails, and the send is skipped —
/// which is what makes cron re-runs and retried webhooks safe.
model EmailSend {
  id                Int      @id @default(autoincrement())
  /// Template identity, e.g. "receipt", "expiry_t7".
  kind              String   @db.VarChar(60)
  studentId         Int
  /// What makes this send unique — "order:412", "access:88:T-7".
  refKey            String   @db.VarChar(120)
  providerMessageId String?  @db.VarChar(200)
  sentAt            DateTime @default(now()) @db.DateTime(0)

  @@unique([kind, studentId, refKey], map: "uq_email_send")
  @@index([studentId], map: "idx_email_send_student")
  @@index([sentAt], map: "idx_email_send_sent")
  @@map("tq_email_sends")
}
