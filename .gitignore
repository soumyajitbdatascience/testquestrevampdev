/e2e/.prisma
/e2e/.auth

# Production database dumps — real student PII: 1,203 personal email
# addresses, 1,444 bcrypt hashes, and the legacy `student.encrypt_password`
# column, which holds plaintext for some rows. This repo has a GitHub remote;
# once a dump is in history it cannot be taken back. Keep them out entirely.
dump-*.sql
*.dump.sql
